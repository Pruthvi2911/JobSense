# Embedding Service Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Where ChromaDB stores its files (relative to embedding-service/)
CHROMA_PATH=./chroma_data

# LLM (any OpenAI-compatible endpoint: Groq, Gemini, OpenAI, Ollama)
LLM_BASE_URL=        # e.g. https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: "function_calling" (default) or "json_mode" if the provider has no tool calling
# LLM_STRUCTURED_METHOD=function_calling
